<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StreakStake" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorPrimaryVariant">@color/brand_orange_light</item>
        <item name="colorOnPrimary">@color/text_white</item>
        
        <!-- Background -->
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_white</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
