<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StreakStake" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary accent -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        
        <!-- Dark Cinema Base Background -->
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
