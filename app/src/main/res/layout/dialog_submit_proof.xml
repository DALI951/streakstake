<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/btn_orange_rounded"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="TARGET ACHIEVED"
        android:textColor="@color/bg_black"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProofTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Submit Proof to Peers"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProofMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="500m Walk Completed (650 Steps)"
        android:textColor="@color/brand_orange"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="Your staked XP is locked in escrow until at least one friend taps 'Verify'. Failing peer review burns your stake."
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etProofNote"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Add a note or location (optional)"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSubmitToPeers"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_orange_rounded"
        android:text="LOCK PROOF &amp; REQUEST PEER VERIFY"
        android:textColor="@color/bg_black"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnClaimSolo"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:text="Instant Solo Payout (No Peer Multiplier)"
        android:textColor="@color/text_gray"
        android:textSize="11sp" />

</LinearLayout>
