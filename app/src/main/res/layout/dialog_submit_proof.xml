<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_chip_active"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="TARGET ACHIEVED"
        android:textColor="@color/on_accent"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProofTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-bold"
        android:text="Submit Proof to Peers"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvProofMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="500m Walk Completed (650 Steps)"
        android:textColor="@color/accent_light"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="Your staked XP is in escrow until a peer verifies proof. Peer review prevents cheating and unlocks your reward."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etProofNote"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input_field"
        android:hint="Add note or workout location (optional)"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_disabled"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnSubmitToPeers"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_accent_primary"
        android:fontFamily="sans-serif-bold"
        android:text="Lock Proof &amp; Request Peer Review"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnClaimSolo"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:text="Solo Mode Payout (Instant)"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

</LinearLayout>
