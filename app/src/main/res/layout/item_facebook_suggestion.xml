<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvSuggestionAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_avatar"
        android:gravity="center"
        android:text="F"
        android:textColor="@color/accent_light"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSuggestionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Facebook Friend"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSuggestionHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@facebook_friend • Uses StreakStake"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Dismiss/Delete button -->
    <Button
        android:id="@+id/btnDeleteSuggestion"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/btn_outlined_hairline"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="10dp"
        android:text="Delete"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Add button -->
    <Button
        android:id="@+id/btnAddSuggestion"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/btn_accent_primary"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="14dp"
        android:text="Add"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="12sp" />

</LinearLayout>
