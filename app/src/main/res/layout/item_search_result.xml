<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvResultAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_avatar"
        android:gravity="center"
        android:text="U"
        android:textColor="@color/accent_light"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResultName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Athlete Name"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvResultHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@handle • ID: XXXXXXXX"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnResultAdd"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/btn_accent_primary"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="14dp"
        android:text="Add"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="11sp" />

</LinearLayout>
