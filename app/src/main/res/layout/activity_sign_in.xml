<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- App Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <!-- Title & Subtitle (From Calisthenics AuthScaffold) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="-0.02"
            android:text="Welcome back"
            android:textColor="@color/text_primary"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sign in to keep your training streak alive."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Auth Card (AppCard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Primary 1-Tap Google Button -->
            <Button
                android:id="@+id/btnGoogleFast"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_accent_primary"
                android:fontFamily="sans-serif-bold"
                android:text="Continue with Google"
                android:textAllCaps="false"
                android:textColor="@color/on_accent"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="Instant one-tap entry • 500 XP granted"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Hairline "or" divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/hairline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="or"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/hairline" />
            </LinearLayout>

            <!-- Toggle Custom Account -->
            <Button
                android:id="@+id/btnCustomAccountToggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_outlined_hairline"
                android:fontFamily="sans-serif-medium"
                android:text="Sign In with Custom Account"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <!-- Collapsible Custom Email Form -->
            <LinearLayout
                android:id="@+id/layoutCustomAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCustomName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Gamer Tag / Username"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etCustomEmail"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Email (Optional)"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etCustomPassword"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_disabled"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCustomSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_accent_primary"
                    android:fontFamily="sans-serif-bold"
                    android:text="Create / Sign In"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="13sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>

        <!-- Motivating Empty/Status footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Dark cinema UI • Native Android • 0 Clutter"
            android:textColor="@color/text_disabled"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
