<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher" />

        <!-- Title & Slogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:text="STREAKSTAKE"
            android:textColor="@color/brand_orange"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.04"
            android:text="STAKE XP. WALK. PROOF OR BURN."
            android:textColor="@color/text_gray"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Starter Grant Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="⚡ 500 XP Welcome Balance Included"
            android:textColor="@color/brand_orange"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Main Instant Google Sign-In Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Instant One-Tap Access"
                android:textColor="@color/text_white"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No forms, no personal info required. Instant challenger access."
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <!-- Prominent Google One-Tap Sign In Button -->
            <Button
                android:id="@+id/btnGoogleFast"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_orange_rounded"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:text="CONTINUE WITH GOOGLE"
                android:textAllCaps="false"
                android:textColor="@color/bg_black"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            <!-- Discreet Custom Login Toggle -->
            <TextView
                android:id="@+id/tvToggleCustomAuth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:padding="6dp"
                android:text="Or sign in with custom credentials ▾"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <!-- Collapsible Custom Email Form -->
            <LinearLayout
                android:id="@+id/layoutCustomAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etCustomName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Gamer Tag / Username"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etCustomEmail"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Email (Optional)"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etCustomPassword"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_white"
                    android:textColorHint="@color/text_gray"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnCustomSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="sans-serif-bold"
                    android:text="Sign In with Custom Account"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_orange"
                    android:textSize="13sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Pure Native Android • Sensor &amp; Peer Verified"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
