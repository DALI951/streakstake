<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvInviteAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_avatar"
        android:gravity="center"
        android:text="U"
        android:textColor="@color/accent_light"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvInviteName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Requester Name"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvInviteHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@requester"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDeclineInvite"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/btn_outlined_hairline"
        android:contentDescription="Decline"
        android:drawableTop="@drawable/ic_app_close"
        android:padding="8dp" />

    <Button
        android:id="@+id/btnAcceptInvite"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/btn_accent_primary"
        android:contentDescription="Accept"
        android:drawableTop="@drawable/ic_app_check"
        android:padding="8dp" />

</LinearLayout>
