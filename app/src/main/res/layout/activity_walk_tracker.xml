<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_outlined_hairline"
            android:contentDescription="Close"
            android:padding="10dp"
            android:src="@drawable/ic_app_close" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Walk Tracker"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvStakeLockedPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="100 XP Staked"
            android:textColor="@color/accent_light"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Counter Card (AppCard with glow) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_highlight"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSensorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Native Step Detector Active"
            android:textColor="@color/accent_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Distance Display (Tabular Figures) -->
        <TextView
            android:id="@+id/tvMetersCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/tvMetersTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06"
            android:text="/ 500 METERS"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/pbWalk"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent" />

        <!-- Steps & Timer Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvStepsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.04"
                    android:text="STEPS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.04"
                    android:text="ELAPSED TIME"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Complete Button (Enabled when target met) -->
        <Button
            android:id="@+id/btnCompleteWalk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_accent_primary"
            android:enabled="false"
            android:fontFamily="sans-serif-bold"
            android:text="Complete Walk &amp; Claim XP"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="14sp"
            app:backgroundTint="@null" />

        <!-- Simulation Step Button (For testing) -->
        <Button
            android:id="@+id/btnSimulateSteps"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_outlined_hairline"
            android:text="+50 Steps Simulator (~38m)"
            android:textAllCaps="false"
            android:textColor="@color/accent_light"
            android:textSize="12sp"
            app:backgroundTint="@null" />

        <!-- Give Up Button -->
        <Button
            android:id="@+id/btnGiveUp"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:text="Give Up &amp; Burn Stake"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
