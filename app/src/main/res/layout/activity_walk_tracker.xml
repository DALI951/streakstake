<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_field"
            android:text="✕"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            app:backgroundTint="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:text="LIVE WALK TRACKER"
            android:textColor="@color/brand_orange"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvStakeLockedPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="100 XP Staked"
            android:textColor="@color/brand_orange"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Main Counter Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvSensorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Accelerometer &amp; Step Sensor Active"
            android:textColor="@color/brand_orange"
            android:textSize="11sp" />

        <!-- Distance Display -->
        <TextView
            android:id="@+id/tvMetersCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/tvMetersTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.1"
            android:text="/ 500 METERS"
            android:textColor="@color/text_gray"
            android:textSize="16sp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/pbWalk"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="24dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/brand_orange" />

        <!-- Steps & Timer Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Steps Counted"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvStepsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="0"
                    android:textColor="@color/text_white"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elapsed Time"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="00:00"
                    android:textColor="@color/text_white"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Complete Button (Enabled when target met) -->
        <Button
            android:id="@+id/btnCompleteWalk"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_orange_rounded"
            android:enabled="false"
            android:fontFamily="sans-serif-black"
            android:text="Complete Walk &amp; Claim XP"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            app:backgroundTint="@null" />

        <!-- Simulation Step Button (For testing) -->
        <Button
            android:id="@+id/btnSimulateSteps"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:text="+50 Steps Simulator (~38m)"
            android:textAllCaps="false"
            android:textColor="@color/brand_orange"
            android:textSize="12sp"
            app:backgroundTint="@null" />

        <!-- Give Up Button -->
        <Button
            android:id="@+id/btnGiveUp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:text="Give Up &amp; Burn Stake"
            android:textAllCaps="false"
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
