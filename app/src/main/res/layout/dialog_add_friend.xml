<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_dark"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="Add Friend"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnCloseDialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_app_close" />
    </LinearLayout>

    <!-- 3 Option Selector Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabSearch"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_chip_active"
            android:fontFamily="sans-serif-bold"
            android:text="Search"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabId"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_chip"
            android:fontFamily="sans-serif-bold"
            android:text="8-Char ID"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTabQr"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_chip"
            android:fontFamily="sans-serif-bold"
            android:text="QR Code"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- CONTAINER 1: SEARCH DATABASE -->
    <LinearLayout
        android:id="@+id/layoutOptionSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/etSearchUser"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@drawable/ic_app_search"
            android:drawablePadding="10dp"
            android:hint="Search real name or @tag..."
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSearchNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Type to find registered athletes. Nonexistent accounts cannot be added."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/containerSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- CONTAINER 2: 8-CHARACTER ID -->
    <LinearLayout
        android:id="@+id/layoutOptionId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="YOUR UNIQUE 8-CHAR ID"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_highlight"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvMy8CharId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="K9#mX2!a"
                android:textColor="@color/accent_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCopyMyId"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_outlined_hairline"
                android:drawableStart="@drawable/ic_app_copy"
                android:drawablePadding="6dp"
                android:paddingHorizontal="10dp"
                android:text="Copy"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.04"
            android:text="ENTER FRIEND'S 8-CHAR ID"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTarget8CharId"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="monospace"
            android:hint="e.g. M7#xK9!w"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSendIdInvite"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_accent_primary"
            android:fontFamily="sans-serif-bold"
            android:text="Send Friend Invitation"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- CONTAINER 3: QR CODE -->
    <LinearLayout
        android:id="@+id/layoutOptionQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.04"
            android:text="SCAN TO CONNECT"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivMyQrCode"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:contentDescription="QR Code"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvQrAccountInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Athlete • @handle"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFriendQrInput"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="Paste or enter Friend's QR code..."
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_disabled"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnConnectQr"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_accent_primary"
            android:fontFamily="sans-serif-bold"
            android:text="Connect via QR"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
