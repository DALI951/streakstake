<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header Profile Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Avatar"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Challenger"
                        android:textColor="@color/text_white"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="challenger@streakstake.app"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSignOut"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_field"
                    android:text="Exit"
                    android:textAllCaps="false"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Stats Bar (Two-Color Black & Orange) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- XP Available -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available XP"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvXpBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-black"
                        android:text="500 XP"
                        android:textColor="@color/brand_orange"
                        android:textSize="22sp" />
                </LinearLayout>

                <!-- Current Streak -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Streak"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStreakCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-black"
                        android:text="0 Days"
                        android:textColor="@color/text_white"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section 1: Walk Target & Step Detector Staker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="WALK DISTANCE STAKE"
                    android:textColor="@color/brand_orange"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Walk X meters. Real-time accelerometer step counter &amp; GPS detection."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <!-- Distance Presets -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Target Meters"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDist250"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:text="250m"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnDist500"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_orange_rounded"
                        android:text="500m"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnDist1000"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:text="1000m"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Stake Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="XP to Stake"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStake50"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:text="50 XP"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnStake100"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_orange_rounded"
                        android:text="100 XP"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnStake200"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:text="200 XP"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Start Walk Tracker Button -->
                <Button
                    android:id="@+id/btnStartWalk"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/btn_orange_rounded"
                    android:fontFamily="sans-serif-black"
                    android:text="Lock Stake &amp; Start Walking"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />

            </LinearLayout>

            <!-- Section 2: Active Stakes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-black"
                android:text="ACTIVE STAKES"
                android:textColor="@color/text_white"
                android:textSize="15sp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyStakes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Active Stakes"
                    android:textColor="@color/text_white"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Set a walk target above to lock your first stake."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Stakes Container -->
            <LinearLayout
                android:id="@+id/layoutStakesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
