<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:orientation="vertical">

    <!-- Top App Bar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar Circle -->
            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_avatar"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/accent_light"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Athlete"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvUserHandle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@athlete"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dedicated Settings Button with Custom Vector Icon (Zero Emojis) -->
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/btn_outlined_hairline"
                android:contentDescription="Settings"
                android:padding="10dp"
                android:src="@drawable/ic_app_settings" />
        </LinearLayout>

        <!-- Hairline Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/hairline" />

        <!-- 3-Column Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Stat 1: Available XP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvXpBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="500 XP"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.04"
                    android:text="AVAILABLE XP"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stat 2: Streak -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvStreakCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0 Days"
                    android:textColor="@color/accent_light"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.04"
                    android:text="DAY STREAK"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Stat 3: Completed / Won -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvCompletedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="0 Won"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.04"
                    android:text="VERIFIED"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- CONTENT CONTAINER -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================================== -->
        <!-- TAB 1: HOME PAGE (TOP: YOUR GOAL, BOTTOM: FRIEND CHALLENGES) -->
        <!-- ============================================== -->
        <ScrollView
            android:id="@+id/layoutHomeTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- TOP HALF: YOUR ACTIVE CHALLENGE / CUSTOM GOAL CREATOR -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="YOUR ACTIVE CHALLENGE"
                    android:textColor="@color/accent_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Active Goal In Progress Card (visible when user has active stake) -->
                <LinearLayout
                    android:id="@+id/layoutActiveStakeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_highlight"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveStakeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:text="100 Pushups Challenge"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvActiveStakeXpBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_chip_active"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="100 XP Staked"
                            android:textColor="@color/on_accent"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbActiveStakeProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="12dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="35"
                        android:progressBackgroundTint="@color/surface_high"
                        android:progressTint="@color/accent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveStakeProgressText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="35 / 100 reps completed"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvActiveStakePercentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="35%"
                            android:textColor="@color/accent_light"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnOpenWalkTracker"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/btn_accent_primary"
                        android:fontFamily="sans-serif-bold"
                        android:text="Open Tracker &amp; Log Progress"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="13sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Fully Customizable Challenge Creator Card -->
                <LinearLayout
                    android:id="@+id/layoutGoalCreator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:text="CHALLENGE NAME"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Custom Challenge Title Input -->
                    <EditText
                        android:id="@+id/etChallengeTitleInput"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="e.g. 100 Pushups, 50 Pull-ups, 3km Run"
                        android:paddingHorizontal="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_disabled"
                        android:textSize="13sp" />

                    <!-- Quick Preset Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPresetPushups"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip_active"
                            android:text="Pushups"
                            android:textColor="@color/on_accent"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <Button
                            android:id="@+id/btnPresetPullups"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip"
                            android:text="Pull-ups"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <Button
                            android:id="@+id/btnPresetSquats"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip"
                            android:text="Squats"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <Button
                            android:id="@+id/btnPresetWalk"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip"
                            android:text="Walk/Run"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <!-- Target Number & Unit Inputs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <!-- Target Number -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="TARGET NUMBER"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etTargetNumberInput"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_field"
                                android:hint="100"
                                android:inputType="number"
                                android:paddingHorizontal="12dp"
                                android:text="100"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_disabled"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Unit Selector -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.04"
                                android:text="UNIT"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnUnitReps"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginEnd="2dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_pill_chip_active"
                                    android:text="Reps"
                                    android:textColor="@color/on_accent"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnUnitMeters"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginHorizontal="2dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_pill_chip"
                                    android:text="Meters"
                                    android:textColor="@color/text_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@null" />

                                <Button
                                    android:id="@+id/btnUnitMins"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="2dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_pill_chip"
                                    android:text="Mins"
                                    android:textColor="@color/text_primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    app:backgroundTint="@null" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Lock XP Stake -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:letterSpacing="0.04"
                        android:text="LOCK YOUR XP STAKE"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnStake50"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip"
                            android:text="50 XP"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <Button
                            android:id="@+id/btnStake100"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip_active"
                            android:text="100 XP"
                            android:textColor="@color/on_accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <Button
                            android:id="@+id/btnStake250"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip"
                            android:text="250 XP"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                        <Button
                            android:id="@+id/btnStake500"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_chip"
                            android:text="500 XP"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnLockStake"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/btn_accent_primary"
                        android:fontFamily="sans-serif-bold"
                        android:text="Lock Stake &amp; Start Challenge"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="13sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- BOTTOM HALF: FRIEND CHALLENGES WITH REAL-TIME COUNTDOWN TIMER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="FRIEND CHALLENGES &amp; TIMERS"
                        android:textColor="@color/accent_light"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFriendChallengesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Active"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Container for Friend Challenges Cards -->
                <LinearLayout
                    android:id="@+id/containerFriendChallenges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Empty State if no friends or no active challenges -->
                <LinearLayout
                    android:id="@+id/layoutNoFriendChallenges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_dark"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Friends"
                        android:src="@drawable/ic_app_friends" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="No friend challenges active"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Add friends on the Friends tab to track their live stakes and countdowns."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnGoToFriendsTab"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_outlined_hairline"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="16dp"
                        android:text="Find Friends"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- TAB 2: FRIENDS PAGE (ADD, INVITATIONS, FACEBOOK SUGGESTIONS) -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutFriendsTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Friends Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Accountability Circle"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <!-- Add Friend Button with Vector Icon -->
                <Button
                    android:id="@+id/btnAddFriendModal"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_accent_primary"
                    android:drawableStart="@drawable/ic_app_add_user"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="12dp"
                    android:text="Add Friend"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- 3 Subtabs / Filter Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSubTabFriends"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_chip_active"
                    android:fontFamily="sans-serif-bold"
                    android:text="Friends"
                    android:textAllCaps="false"
                    android:textColor="@color/on_accent"
                    android:textSize="11sp"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnSubTabInvitations"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_chip"
                    android:fontFamily="sans-serif-bold"
                    android:text="Invites (0)"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnSubTabSuggestions"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_pill_chip"
                    android:fontFamily="sans-serif-bold"
                    android:text="Suggested"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Scrollable Subtab Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Sub-view 1: Confirmed Friends List -->
                    <LinearLayout
                        android:id="@+id/layoutSubFriends"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/containerFriendsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvEmptyFriends"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:gravity="center"
                            android:text="No friends added yet.\nTap 'Add Friend' above to invite via QR Code, 8-Char ID, or Facebook."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Sub-view 2: Incoming Invitations -->
                    <LinearLayout
                        android:id="@+id/layoutSubInvitations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/containerInvitationsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvEmptyInvitations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:gravity="center"
                            android:text="No pending invitations.\nWhen an athlete invites you, it will appear here."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Sub-view 3: Facebook Friend Suggestions -->
                    <LinearLayout
                        android:id="@+id/layoutSubSuggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Athletes from your Facebook circle using StreakStake:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/containerSuggestionsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvEmptySuggestions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:gravity="center"
                            android:text="No Facebook friend suggestions available right now."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

    </FrameLayout>

    <!-- ShellBottomNav: EXACTLY TWO TABS (HOME & FRIENDS) WITH BESPOKE VECTOR ICONS -->
    <LinearLayout
        android:id="@+id/bottomNavShell"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- TAB 1: HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavHomeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_app_home" />

            <TextView
                android:id="@+id/tvNavHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-bold"
                android:text="Home"
                android:textColor="@color/accent_light"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Hairline Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="@color/hairline" />

        <!-- TAB 2: FRIENDS -->
        <LinearLayout
            android:id="@+id/navFriends"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavFriendsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Friends"
                android:src="@drawable/ic_app_friends" />

            <TextView
                android:id="@+id/tvNavFriendsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-bold"
                android:text="Friends"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
